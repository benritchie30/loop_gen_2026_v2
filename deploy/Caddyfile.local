# The public site's setup on your own computer, for a rehearsal (plain http, no
# certificate). Same rules as deploy/Caddyfile; only the address (any name, port 8080)
# and the folder differ.
#
#   1. backend:  cd backend, then  set LOOP_ALLOWED_ORIGINS=http://localhost:8080
#                and  python server.py   (Linux/macOS: LOOP_ALLOWED_ORIGINS=... python server.py)
#   2. UI:       cd route-loop-finder && npm run build
#   3. Caddy:    from the project folder:  caddy run --config deploy/Caddyfile.local
#   4. open http://localhost:8080
{
	admin off
}

http://:8080 {
	encode zstd gzip

	handle /ws {
		reverse_proxy localhost:8765
	}
	handle /healthz {
		reverse_proxy localhost:8765
	}

	# The built UI (npm run build). File names under /assets/ change with every
	# build, so browsers may keep them for good (a missing one is a 404); every other
	# path is the app itself (index.html), checked again on every visit.
	handle /assets/* {
		# Relative to the folder Caddy is started in (the project folder).
		root * route-loop-finder/dist
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * route-loop-finder/dist
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
