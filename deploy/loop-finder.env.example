# Settings for the backend (installed as /etc/loop-finder.env by setup.sh, which
# fills in the domain and contact). After a change: systemctl restart loop-finder
# Every setting is described in RUNNING.md. One per line, no quotes, no spaces around =.

# Only pages from the site may connect (exactly the address in the browser, https://...).
LOOP_ALLOWED_ORIGINS=https://loops.example.com

# Who the public map data servers (Overpass) can contact about this app's requests.
LOOP_CONTACT=contact@example.com

# Where downloaded map tiles are kept (the service may only write under /var/lib/loop-finder).
LOOP_MAP_DIR=/var/lib/loop-finder/map_data

# Listen on this machine only; Caddy forwards /ws and /healthz here.
LOOP_HOST=localhost
LOOP_PORT=8765

# Limits (the defaults suit a 4 GB server; uncomment to change)
#LOOP_MAX_MILES=50
#LOOP_SEARCH_SLOTS=1
#LOOP_MAX_AREAS=4
#LOOP_MAX_SESSIONS=12
#LOOP_TILE_CACHE=16
#LOOP_IDLE_MINUTES=30
#LOOP_MAX_CONN_PER_IP=8
#LOOP_MAX_CONNECTIONS=100
